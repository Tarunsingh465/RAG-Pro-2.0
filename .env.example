# ==========================================
# API Keys
# ==========================================
# Primary LLM Provider: NVIDIA NIM (Free 1,000 credits at https://build.nvidia.com)
NVIDIA_API_KEY=nvapi-your-nvidia-api-key

# Alternative LLM Provider (Optional):
OPENROUTER_API_KEY=

# Vector Database & Google Embeddings
GOOGLE_API_KEY=your-google-api-key
PINECONE_API_KEY=your-pinecone-api-key

# Optional (Only needed if you want cloud OCR for scanned PDFs & images):
# If omitted, local pypdf extractor is used for PDFs (100% free)
MISTRAL_API_KEY=

# ==========================================
# Pinecone
# ==========================================
PINECONE_INDEX_NAME=tyrion-2-0
PINECONE_NAMESPACE=default

# ==========================================
# Models
# ==========================================
# Best free models on NVIDIA NIM: meta/llama-3.3-70b-instruct or nvidia/llama-3.1-nemotron-70b-instruct
LLM_MODEL=meta/llama-3.3-70b-instruct
EMBEDDING_MODEL=models/gemini-embedding-001
EMBEDDING_DIMENSION=3072

# ==========================================
# Retrieval
# ==========================================
TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.65
BM25_SIMILARITY_THRESHOLD=5.0

# ==========================================
# Chunking
# ==========================================
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# ==========================================
# Application
# ==========================================
APP_NAME=TYRION-2.0
APP_VERSION=2.0.0
DEBUG=false
